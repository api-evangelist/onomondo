{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onomondo Connectors Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onomondo.com/tags/search/tags"
          },
          "docs": "Returns Tags for the organization. Tags are created and updated in the web app, not via the API."
        }
      ]
    }
  ],
  "bundled": true
}